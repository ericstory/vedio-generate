# Copy to .env and fill secrets. Never commit .env.
MODELARK_API_KEY=
MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

SEEDANCE_25_ENDPOINT=
SEEDANCE_2_MINI_ENDPOINT=
SEEDANCE_2_FAST_ENDPOINT=
SEEDANCE_20_ENDPOINT=

# Independent self-hosted LTX 2.3 chain (RunPod Serverless).
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_API_BASE_URL=https://api.runpod.ai/v2
RUNPOD_MANAGEMENT_API_BASE_URL=https://api.runpod.io/v2
# Emergency rollback only; v1 cannot address newer regions such as US-NC-2.
RUNPOD_API_V1=0
RUNPOD_COST_GUARD_ENABLED=1
RUNPOD_COST_GUARD_POLL_SECONDS=8
SELF_HOSTED_MODEL_ID=SexGod1979/PinkCherry_NSFW_LTX23
SELF_HOSTED_MODEL_VERSION=PinkCherry_FineTune_bf16_v1_8_LTX23
SELF_HOSTED_WORKFLOW_VERSION=pinkcherry-native-two-stage-v1

# Independent Wan 2.2 A14B + mandatory adult LoRA V2 on an on-demand 96GB Pod.
# Keep disabled until the image, callback, and automatic deletion pass a real smoke test.
WAN_V2_ENABLED=0
RUNPOD_WAN_POD_TEMPLATE_ID=
RUNPOD_WAN_POD_NETWORK_VOLUME_ID=
RUNPOD_WAN_POD_CALLBACK_URL=https://your-host.example/generate/api/internal/pod-result
RUNPOD_WAN_POD_GPU_ID=NVIDIA RTX PRO 6000 Blackwell Server Edition
RUNPOD_WAN_POD_DATA_CENTER_ID=US-KS-2
RUNPOD_WAN_POD_FALLBACK_DATA_CENTER_ID=US-NE-1
RUNPOD_WAN_POD_FALLBACK_NETWORK_VOLUME_ID=
# Ordered extra region/volume pairs tried only after the primary and fallback lanes.
RUNPOD_WAN_POD_ADDITIONAL_REGION_VOLUMES=[{"data_center_id":"US-NC-2","network_volume_id":""}]
RUNPOD_WAN_POD_MAX_PRICE_PER_HOUR=3.0
RUNPOD_WAN_POD_MAX_RUNTIME_SECONDS=1800
WAN_MODEL_ID=nvidia/Wan2.2-T2V-A14B-Diffusers-FP8
WAN_MODEL_VERSION=2c5a06469cd2255816eb2e46b8e11600ed435d52
WAN_ADULT_ADAPTER_ID=lopi999/Wan2.2-I2V_General-NSFW-LoRA
WAN_ADULT_ADAPTER_VERSION=aeef17d7fa51d753ab7d1004ddb4f218a95d756d
WAN_ADULT_ADAPTER_STRENGTH=0.9
WAN_WORKFLOW_VERSION=wan22-t2v-fp8-resident96-adult-lora-audio-v5

# MiniMax H3 main line: PinkCherry fine-tuned DiT + lightx2v 8-step turbo LoRA on
# the same on-demand 96GB Pod contract. Native 32kHz stereo audio in one pass, so
# there is no second audio model. Keep disabled until a real smoke test passes.
# See docs/model-gpu-selection-2026-09.md for why this lane exists.
H3_ENABLED=0
RUNPOD_H3_POD_TEMPLATE_ID=
RUNPOD_H3_POD_NETWORK_VOLUME_ID=
RUNPOD_H3_POD_CALLBACK_URL=https://your-host.example/generate/api/internal/pod-result
RUNPOD_H3_POD_GPU_ID=NVIDIA RTX PRO 6000 Blackwell Server Edition
# US-NC-2 held the best RTX PRO 6000 secure stock in repeated 2026-08-31 sampling.
RUNPOD_H3_POD_DATA_CENTER_ID=US-NC-2
RUNPOD_H3_POD_FALLBACK_DATA_CENTER_ID=US-KS-2
RUNPOD_H3_POD_FALLBACK_NETWORK_VOLUME_ID=
RUNPOD_H3_POD_ADDITIONAL_REGION_VOLUMES=[]
RUNPOD_H3_POD_MAX_PRICE_PER_HOUR=3.0
RUNPOD_H3_POD_MAX_RUNTIME_SECONDS=1800
H3_MODEL_ID=MiniMaxAI/MiniMax-H3
H3_MODEL_VERSION=42ed227ee7df40d41602854ae760620d6eb651fe
H3_NSFW_MODEL_ID=SexGod1979/PinkCherry_MiniMax-H3
H3_NSFW_MODEL_VERSION=bf2fef11d0e55e957f4af997e3beade3362f44b3
H3_WORKFLOW_VERSION=h3-fl2va-pinkcherry-turbo8-v1

# Authenticated GPU-worker upload into the Railway persistent volume.
VIDEO_UPLOAD_TOKEN=
VIDEO_OUTPUT_DIR=data/generated-videos

BYTEPLUS_AK=
BYTEPLUS_SK=
ASSET_LIBRARY_PROJECT_NAME=hunjp
ASSET_LIBRARY_REGION=ap-southeast-1
ASSET_LIBRARY_API_HOST=ark.ap-southeast-1.byteplusapi.com

# Web admin. Use a long, unique value for SESSION_SECRET in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=
# Leave blank for a host-only cookie (recommended for the standalone service).
COOKIE_DOMAIN=
APP_BASE_PATH=/generate
TASK_DATABASE_PATH=data/tasks.db
